#cloud-config
# Flightscope Mk I - first-boot provisioning (Raspberry Pi OS Trixie, cloud-init NoCloud)

hostname: flightscope
manage_etc_hosts: true
timezone: Europe/London
locale: en_GB.UTF-8

users:
  - name: pi
    gecos: Flightscope
    groups: users,adm,dialout,audio,netdev,video,plugdev,input,gpio,spi,i2c,render,sudo
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAA...your-public-key... you@your-machine
    sudo: ALL=(ALL) NOPASSWD:ALL

enable_ssh: true
ssh_pwauth: false

rpi:
  i2c: true       # UPS HAT fuel gauge
  spi: false

package_update: true
package_upgrade: false
packages:
  - git
  - python3-pip
  - python3-venv
  - i2c-tools
  - gpsd
  - gpsd-clients
  - libsdl2-2.0-0
  - libsdl2-image-2.0-0
  - libsdl2-ttf-2.0-0
  - libsdl2-mixer-2.0-0

runcmd:
  - [ systemctl, disable, --now, hciuart ]
  - [ systemctl, disable, --now, serial-getty@ttyAMA0.service ]
